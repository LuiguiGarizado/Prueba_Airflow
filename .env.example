COMPOSE_PROJECT_NAME=pruebadesempeno

# Configuracion general de Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Usuario y clave para entrar a la pagina web (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin_password

# Llave de encriptacion Fernet obligatoria (debes generarla manualmente)
# Ejecuta este comando en tu terminal y pega el resultado abajo:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Base de datos interna de Airflow (puerto 5434)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_db_password
AIRFLOW_DB_NAME=airflow

# Base de datos analitica donde se guardan las tablas finales (puerto 5433)
DW_USER=admin_dw
DW_PASSWORD=analytics_password
DW_DB=data_warehouse
